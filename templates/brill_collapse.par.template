# Brill wave vacuum critical collapse -- parfile template
# =================================================================
# Time-symmetric Holz-type Brill wave (sigma = 1) evolved with ML_BSSN
# in moving-puncture gauge on an octant-symmetric Carpet grid with fixed
# mesh refinement centred on the origin.
#
# Placeholders, rendered by scripts/bisection_runner.py (any placeholder
# left unrendered aborts the render):
#   __AMPLITUDE__   Brill wave amplitude A
#   __FINAL_TIME__  physical end time t_max
#
# STATUS: skeleton, NOT RUNNABLE YET -- the initial data block below is
# an open design decision (see CLAUDE.md, "Open issues").
#
# Every parameter name in this file was checked against the param.ccl
# files of the ET_2025_05 build in the base image.

Cactus::cctk_run_title             = "Brill wave collapse, A = __AMPLITUDE__"
Cactus::cctk_full_warnings         = yes
Cactus::highlight_warning_messages = no

Cactus::terminate       = "time"
Cactus::cctk_final_time = __FINAL_TIME__

# The runner starts cactus_sim inside the run directory, so output lands
# in <run_dir>/output.
ActiveThorns = "IOUtil"
IO::out_dir = "output"


# =================================================================
# Infrastructure
# =================================================================

ActiveThorns = "
  AEILocalInterp
  Fortran
  GenericFD
  GSL
  HDF5
  InitBase
  LocalInterp
  LoopControl
  Slab
  SystemTopology
  TGRtensor
"

ActiveThorns = "Carpet CarpetLib CarpetInterp CarpetReduce CarpetSlab"

Carpet::verbose           = no
Carpet::veryverbose       = no
Carpet::schedule_barriers = no
Carpet::storage_verbose   = no

CarpetLib::output_bboxes = no

# Fill freshly allocated memory and timelevels with NaN-like poison, so
# reading uninitialised data trips NaNChecker instead of passing silently.
Carpet::poison_new_timelevels = yes
CarpetLib::poison_new_memory  = yes


# =================================================================
# Grid: octant symmetry (x, y, z >= 0)
# =================================================================
# A Brill wave is axisymmetric about z and even under z -> -z, so it is
# invariant under all three coordinate reflections. Only one octant is
# evolved; ReflectionSymmetry fills the symmetry ghost zones.

ActiveThorns = "Boundary CartGrid3D CoordBase ReflectionSymmetry SymBase"

CartGrid3D::type = "coordbase"

# Outer boundary at R = 24. Radiation leaving at t ~ 1-2 and reflected
# off the boundary returns to the centre at t ~ 2R = 48 > t_max.
# Coarse dx = 0.2, so four levels give a finest spacing of 0.025.
CoordBase::domainsize = "minmax"
CoordBase::xmin =  0.0
CoordBase::ymin =  0.0
CoordBase::zmin =  0.0
CoordBase::xmax = 24.0
CoordBase::ymax = 24.0
CoordBase::zmax = 24.0
CoordBase::dx   =  0.2
CoordBase::dy   =  0.2
CoordBase::dz   =  0.2

CoordBase::boundary_size_x_lower = 3
CoordBase::boundary_size_y_lower = 3
CoordBase::boundary_size_z_lower = 3
CoordBase::boundary_size_x_upper = 3
CoordBase::boundary_size_y_upper = 3
CoordBase::boundary_size_z_upper = 3

# The origin is a grid point; the symmetry ghost zones sit outside it.
CoordBase::boundary_shiftout_x_lower = 1
CoordBase::boundary_shiftout_y_lower = 1
CoordBase::boundary_shiftout_z_lower = 1

ReflectionSymmetry::reflection_x   = yes
ReflectionSymmetry::reflection_y   = yes
ReflectionSymmetry::reflection_z   = yes
ReflectionSymmetry::avoid_origin_x = no
ReflectionSymmetry::avoid_origin_y = no
ReflectionSymmetry::avoid_origin_z = no


# =================================================================
# Mesh refinement: fixed, centred on the origin
# =================================================================
#   level  dx      box (octant)
#   0      0.2     [0, 24]^3
#   1      0.1     [0, 12]^3
#   2      0.05    [0,  4]^3
#   3      0.025   [0,  2]^3
# Near the threshold the curvature peaks on the z axis away from the
# origin (Hilditch et al. 2017, arXiv:1706.01829), so the finest box must
# cover those peaks, not just the origin. TODO: confirm their position
# with the first runs and resize level 3 if needed.

ActiveThorns = "CarpetRegrid2"

Carpet::domain_from_coordbase = yes
Carpet::max_refinement_levels = 4
Carpet::ghost_size            = 3
Carpet::use_buffer_zones      = yes

Carpet::prolongation_order_space = 5
Carpet::prolongation_order_time  = 2
Carpet::init_fill_timelevels     = yes

Carpet::time_refinement_factors = "[1, 2, 4, 8]"

CarpetRegrid2::regrid_every = 0
CarpetRegrid2::num_centres  = 1
CarpetRegrid2::num_levels_1 = 4
CarpetRegrid2::radius_1[1]  = 12.0
CarpetRegrid2::radius_1[2]  =  4.0
CarpetRegrid2::radius_1[3]  =  2.0


# =================================================================
# Time integration
# =================================================================
# Courant factor 0.25 on every level: dt = 0.05 on level 0 and
# 0.00625 on level 3, so one coarse step is 8 iterations and
# t_max = 30 is 4800 iterations.

ActiveThorns = "MoL Time"

MoL::ODE_Method             = "RK4"
MoL::MoL_Intermediate_Steps = 4
MoL::MoL_Num_Scratch_Levels = 1

Time::dtfac = 0.25


# =================================================================
# Spacetime variables
# =================================================================

ActiveThorns = "
  ADMBase
  ADMCoupling
  ADMMacros
  CoordGauge
  SpaceMask
  StaticConformal
  TmunuBase
"

ADMBase::metric_type       = "physical"
ADMBase::metric_timelevels = 3


# =================================================================
# Initial data: time-symmetric Brill wave, Holz form
# =================================================================
#   ds^2 = psi^4 [ e^{2q} (drho^2 + dz^2) + rho^2 dphi^2 ],   K_ij = 0
#   q(rho, z) = A rho^2 exp(-r^2 / sigma^2),   sigma = 1
# The Hamiltonian constraint reduces to the linear flat-space equation
#   Laplacian(psi) + (1/4) (q_,rhorho + q_,zz) psi = 0,  psi -> 1.
#
# TODO(initial-data): open design decision.
# The stock thorn IDBrillData implements exactly this q function, but it
# solves for psi with the PUGH-era EllBase/EllSOR solver. That solver
# loops over a single local patch with global reductions and syncs from
# inside a local-mode routine, so under Carpet it would solve every
# refinement level independently, with a Robin condition at that level's
# own outer edge. Its test suite only covers PUGH unigrid. A unigrid run
# at dx = 0.025 is out of reach (~640^3 points for R = 16 even in an
# octant), so IDBrillData cannot be used as is.
#
# For reference, the IDBrillData mapping of this family would be:
#   ADMBase::initial_data          = "brilldata"
#   IDBrillData::q_function        = "gundlach"
#   IDBrillData::gundlach_a        = A
#   IDBrillData::gundlach_b        = 2
#   IDBrillData::gundlach_c        = 2
#   IDBrillData::gundlach_r0       = 0.0
#   IDBrillData::gundlach_sigmarho = 1.0
#   IDBrillData::gundlach_sigmar   = 1.0

ADMBase::initial_lapse   = "one"
ADMBase::initial_shift   = "zero"
ADMBase::initial_dtlapse = "zero"
ADMBase::initial_dtshift = "zero"


# =================================================================
# Evolution: ML_BSSN, 1+log slicing, Gamma-driver shift
# =================================================================
# Mapping from the project specification to ML_BSSN parameters:
#   1+log slicing                 harmonicN = 1, harmonicF = 2.0
#   lapse_advection_coeff = 1.0   advectLapse = 1
#   Gamma-driver shift            shiftGammaCoeff = 0.75, advectShift = 1
# Moving-puncture gauge is known to fail for near-critical Brill data
# (Hilditch et al. 2013, arXiv:1309.5008), so expect crashes close to A*.

ActiveThorns = "ML_BSSN ML_BSSN_Helper NewRad"

ADMBase::evolution_method         = "ML_BSSN"
ADMBase::lapse_evolution_method   = "ML_BSSN"
ADMBase::shift_evolution_method   = "ML_BSSN"
ADMBase::dtlapse_evolution_method = "ML_BSSN"
ADMBase::dtshift_evolution_method = "ML_BSSN"

ML_BSSN::fdOrder = 4

ML_BSSN::harmonicN       = 1
ML_BSSN::harmonicF       = 2.0
ML_BSSN::advectLapse     = 1
ML_BSSN::shiftGammaCoeff = 0.75
ML_BSSN::advectShift     = 1
# TODO: the damping term scales as 1/M, and a Brill wave carries no
# mass scale of its own. 1.0 is the binary-black-hole habit, not a
# choice made for this problem.
ML_BSSN::betaDriver      = 1.0
ML_BSSN::minimumLapse    = 1.0e-8

ML_BSSN::initial_boundary_condition = "extrapolate-gammas"
ML_BSSN::rhs_boundary_condition     = "NewRad"
Boundary::radpower                  = 2

ML_BSSN::ML_log_confac_bound = "none"
ML_BSSN::ML_metric_bound     = "none"
ML_BSSN::ML_Gamma_bound      = "none"
ML_BSSN::ML_trace_curv_bound = "none"
ML_BSSN::ML_curv_bound       = "none"
ML_BSSN::ML_lapse_bound      = "none"
ML_BSSN::ML_dtlapse_bound    = "none"
ML_BSSN::ML_shift_bound      = "none"
ML_BSSN::ML_dtshift_bound    = "none"

# Dissipation comes from the Dissipation thorn below; switch off
# ML_BSSN's built-in term so it is not applied twice.
ML_BSSN::epsDiss = 0.0


# =================================================================
# Numerical dissipation (Kreiss-Oliger)
# =================================================================
# Fifth-order operator, which needs ghost_size >= 3.
# TODO: tune epsdis (typically 0.05-0.3) against the constraint
# violation of the first sub- and supercritical runs.

ActiveThorns = "Dissipation SphericalSurface"

Dissipation::order  = 5
Dissipation::epsdis = 0.1
Dissipation::vars   = "
  ML_BSSN::ML_log_confac
  ML_BSSN::ML_metric
  ML_BSSN::ML_trace_curv
  ML_BSSN::ML_curv
  ML_BSSN::ML_Gamma
  ML_BSSN::ML_lapse
  ML_BSSN::ML_shift
  ML_BSSN::ML_dtlapse
  ML_BSSN::ML_dtshift
"


# =================================================================
# Constraint monitoring
# =================================================================

ActiveThorns = "ML_ADMConstraints"


# =================================================================
# Apparent horizon finder
# =================================================================
# Searched every 16 iterations (2 coarse steps, dt = 0.1); must be a
# multiple of the coarse step (8) so that all levels are in sync.
#
# AHFinderDirect only infers octant symmetry from CartGrid3D::domain,
# which stays "full" with ReflectionSymmetry, so the patch system type
# is set explicitly.
#
# TODO: near the threshold this family forms disjoint apparent horizons
# around curvature peaks on the z axis away from the origin
# (arXiv:1706.01829), which a single origin-centred finder will miss.
# Add on-axis horizons ("+xy quadrant (mirrored)" centred at (0, 0, z0))
# once the peak position is known.

ActiveThorns = "AHFinderDirect"

AHFinderDirect::N_horizons = 1
AHFinderDirect::find_every = 16
AHFinderDirect::verbose_level = "physics details"

AHFinderDirect::geometry_interpolator_name = "Lagrange polynomial interpolation"
AHFinderDirect::geometry_interpolator_pars = "order=4"
AHFinderDirect::surface_interpolator_name  = "Lagrange polynomial interpolation"
AHFinderDirect::surface_interpolator_pars  = "order=4"

# Horizon shape files h.t<it>.ah1.gp, written at every find.
AHFinderDirect::output_h_every = 16

AHFinderDirect::patch_system_type[1]                 = "+xyz octant (mirrored)"
AHFinderDirect::origin_x[1]                          = 0.0
AHFinderDirect::origin_y[1]                          = 0.0
AHFinderDirect::origin_z[1]                          = 0.0
AHFinderDirect::initial_guess__coord_sphere__radius[1] = 0.2
AHFinderDirect::reset_horizon_after_not_finding[1]   = yes
AHFinderDirect::which_surface_to_store_info[1]       = 0

SphericalSurface::nsurfaces = 1
SphericalSurface::maxntheta = 39
SphericalSurface::maxnphi   = 76


# =================================================================
# Run safety: NaN detection and graceful termination
# =================================================================
# A NaN terminates the run; the runner reads the NaNChecker messages
# from the log to classify it as a crash.

ActiveThorns = "NaNChecker"

NaNChecker::check_every     = 8
NaNChecker::action_if_found = "terminate"
NaNChecker::check_vars      = "
  ML_BSSN::ML_log_confac
  ML_BSSN::ML_metric
  ML_BSSN::ML_trace_curv
  ML_BSSN::ML_curv
  ML_BSSN::ML_Gamma
  ML_BSSN::ML_lapse
  ML_BSSN::ML_shift
  ADMBase::metric
  ADMBase::lapse
"

# Lets the runner stop a run cleanly (memory guard, or an early stop once
# the horizon mass has settled) by writing 1 into the file. The file is
# created under IO::out_dir, i.e. <run_dir>/output/TERMINATE.
ActiveThorns = "TerminationTrigger"

TerminationTrigger::termination_from_file   = yes
TerminationTrigger::create_termination_file = yes
TerminationTrigger::termination_file        = "TERMINATE"
TerminationTrigger::check_file_every        = 8


# =================================================================
# Output
# =================================================================
# Every 8 iterations = once per coarse step (dt = 0.05).

ActiveThorns = "CarpetIOBasic CarpetIOScalar CarpetIOASCII SystemStatistics"

# Screen table: the runner parses (iteration, time) from it for the ETA.
IOBasic::outInfo_every      = 8
IOBasic::outInfo_reductions = "minimum maximum"
IOBasic::outInfo_vars       = "
  ADMBase::alp
  ML_ADMConstraints::H
  Carpet::physical_time_per_hour
  SystemStatistics::maxrss_mb
"

# Reductions: lapse collapse, constraint violation, memory, throughput.
IOScalar::outScalar_every      = 8
IOScalar::one_file_per_group   = yes
IOScalar::outScalar_reductions = "minimum maximum norm2 norm_inf"
IOScalar::outScalar_vars       = "
  ADMBase::lapse
  ML_ADMConstraints::ML_Ham
  SystemStatistics::process_memory_mb{reductions = 'minimum maximum average'}
  Carpet::timing{reductions = 'average'}
"

# 0D: central lapse alpha(0, 0, 0) and the Carpet timing scalars.
IOASCII::one_file_per_group     = yes
IOASCII::output_symmetry_points = no
IOASCII::out0D_every            = 8
IOASCII::out0D_vars             = "
  ADMBase::lapse
  Carpet::timing
"

# 1D: lapse and Hamiltonian constraint along the axes (dt = 0.8).
IOASCII::out1D_every = 128
IOASCII::out1D_d     = no
IOASCII::out1D_vars  = "
  ADMBase::lapse
  ML_ADMConstraints::ML_Ham
"

