# Brill wave critical collapse -- environment settings template
# Copy this file to `.env` and adjust it for the local machine.
# `.env` is gitignored. The makefiles include it, so every value here
# also overrides the matching make variable.

# ============================================================
# Base image
# ============================================================
# Einstein Toolkit image this project overlays. It is built by the
# GW230529 project (../gw230529-einstein-toolkit, `make docker-build`)
# and already contains every thorn this project needs.
BASE_IMAGE=gw230529-et:local

# ============================================================
# Simulation output directory
# ============================================================
# Host directory for bisection campaigns (parfiles, Cactus output, logs,
# bisection_history.json, resource samples). Use a local SSD, not the NAS:
# AHFinderDirect and the 0D/1D ASCII output write many small files.
# Mounted at /home/etuser/simulations inside the container.
SIM_OUTPUT_DIR=${HOME}/brill-collapse-output

# ============================================================
# Time zone
# ============================================================
# Used for status.json, run summaries and Cactus output headers.
CONTAINER_TZ=Asia/Tokyo

# ============================================================
# Jupyter Lab port
# ============================================================
# 8888 is GW150914 and 8889 is GW230529, so this project takes 8890.
JUPYTER_PORT=8890

# ============================================================
# CPU and memory allocated to the container
# ============================================================
# This host (Core Ultra 9 285H) is heterogeneous: CPUs 0-5 are P-cores
# (5.4 GHz), 6-13 are E-cores (4.5 GHz) and 14-15 are low-power E-cores
# (2.5 GHz). A bulk-synchronous MPI run advances at the pace of its
# slowest rank, so the LP E-cores may cost more than they add. The
# default keeps all 16 CPUs until the np/OMP/cpuset benchmark decides.
CONTAINER_CPUSET=0-15

# Hard memory ceiling. It is the OOM backstop: swap is disabled for the
# container (memswap_limit = mem_limit), so a runaway run is killed
# instead of thrashing the host, and the runner's memory guard aborts a
# run at a fraction of this value before the kernel has to step in.
# The expected footprint of the 4-level octant grid is well below this
# (to be measured in the first single run).
CONTAINER_MEM_LIMIT=48g

# Shared memory for MPICH inter-process communication.
CONTAINER_SHM_SIZE=2gb

# ============================================================
# Simulation parallelism
# ============================================================
# MPI ranks and OpenMP threads per rank for cactus_sim.
# SIM_MPI_PROCS x SIM_OMP_THREADS must not exceed the CPUs in
# CONTAINER_CPUSET. Placeholder values until the benchmark is done.
# The runner always passes OMP_NUM_THREADS explicitly to every rank.
SIM_MPI_PROCS=4
SIM_OMP_THREADS=4
